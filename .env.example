# PostHog product analytics (client-side).
# Defaults baked into lib/analytics.js point at the shared surogate-ops project
# on EU cloud, so these are optional. Override here to send the marketing site to
# a different project or a self-hosted instance. NEXT_PUBLIC_* vars are inlined
# into the static export at build time.
NEXT_PUBLIC_POSTHOG_KEY=phc_zPSN2DHPchukhvPSY4iVSiYxuSaBZ67K6AxKYaTLoGJw
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Firebase (launch page signup flow: Firestore storage + live spots counter).
# Get real values from Firebase Console > Project Settings > Your apps > Web app.
# These are placeholders - the app runs fine with them, it just can't reach a
# real Firestore project until they're replaced.
NEXT_PUBLIC_FIREBASE_API_KEY=dummy-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dummy-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dummy-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dummy-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Set to true to point the app at `firebase emulators:start` instead of live
# Firebase, so you can test the signup flow end-to-end without a real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
